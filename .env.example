# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Base URL of the Shetab backend. The trailing slash is optional; the app
# normalizes it before creating Retrofit and refresh-token requests.
# Android emulator: http://10.0.2.2:4001/
# Physical device: use the computer's LAN IP, for example http://192.168.1.10:4001/
API_BASE_URL=http://192.168.70.141:4001/

# Firebase is temporarily disabled. Uncomment these only after obtaining the
# real Android Firebase values; keep them in .env and never commit that file.
# FIREBASE_APPLICATION_ID=your_value
# FIREBASE_API_KEY=your_value
# FIREBASE_PROJECT_ID=your_value
# FIREBASE_SENDER_ID=your_value
